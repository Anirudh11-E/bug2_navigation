<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="bug2_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Central obstacle -->
    <model name="central_obstacle">
      <static>true</static>

      <pose>0 0 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 3.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 3.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Left obstacle -->
    <model name="left_obstacle">
      <static>true</static>

      <pose>-3 2.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 1.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- Right obstacle -->
    <model name="right_obstacle">
      <static>true</static>

      <pose>3 -2.5 0.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 1.0 1.0</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <!-- START -->
    <model name="start_marker">
      <static>true</static>

      <pose>-4 -4 0.05 0 0 0</pose>

      <link name="link">

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- GOAL -->
    <model name="goal_marker">
      <static>true</static>

      <pose>4 4 0.05 0 0 0</pose>

      <link name="link">

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>
