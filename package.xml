<?xml version="1.0"?>
<package format="2">

  <name>bug2_navigation</name>
  <version>0.0.1</version>

  <description>
    ROS-based autonomous mobile robot navigation using the Bug2 algorithm.
  </description>

  <maintainer email="user@example.com">anirudh</maintainer>

  <license>MIT</license>

